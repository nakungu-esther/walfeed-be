generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  forms     Form[]
  createdAt DateTime @default(now())
}

model Form {
  id          String        @id @default(cuid())
  title       String
  description String?
  fields      Json
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  submissions Submission[]
  createdAt   DateTime      @default(now())

  @@index([userId])
}

model Submission {
  id         String   @id @default(cuid())
  formId     String
  form       Form     @relation(fields: [formId], references: [id])
  data       Json
  walrusHash String?
  adminNote  String?
  priority   String?
  createdAt  DateTime @default(now())

  @@index([formId])
  @@index([createdAt])
}
