PORT=5000
# Neon: pooled URL from dashboard; use ?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_dY1CyFnb4iOI@ep-bold-cherry-apsp08aw-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
JWT_SECRET=supersecret

# Walrus network + aggregator/docs base URL
WALRUS_NETWORK=devnet
WALRUS_ENDPOINT=https://devnet.walrus.xyz

# Optional: HTTP publisher for real blob uploads (PUT /v1/blobs?epochs=N).
# Leave unset to use a dev stub hash (app still runs for judging UI flow).
# Example: https://publisher.walrus.testnet.sui.io
WALRUS_PUBLISHER_URL=
WALRUS_EPOCHS=1
# Max wait (ms) for publisher PUT (default 8000). On timeout or error a stub hash is used.
# WALRUS_PUBLISHER_TIMEOUT_MS=8000

# Seal: envelope metadata (Walrus-aligned label)
SEAL_NETWORK=devnet

# Default: fast local envelope (no Sui / key-server calls). APIs stay responsive.
# Enable real Mysten Seal encryption (slower, needs testnet RPC + key servers):
# SEAL_REAL_ENCRYPT=1
# Optional: force placeholder even if SEAL_REAL_ENCRYPT=1 (emergency off-switch)
# SEAL_PLACEHOLDER_ONLY=1
# Legacy: SEAL_PLACEHOLDER_ONLY=0 also enables real Seal (same as SEAL_REAL_ENCRYPT=1).

# Sui network for Seal RPC (verified key server objects live on testnet)
SEAL_SUI_NETWORK=testnet

# Optional overrides (defaults: Mysten allowlist demo package + identity + two verified independent servers)
# SEAL_POLICY_PACKAGE_ID=0x8afa5d31dbaa0a8fb07082692940ca3d56b5e856c5126cb5a3693f0a4de63b82
# SEAL_IDENTITY_ID=0x5809c296d41e0d6177e8cf956010c1d2387299892bb9122ca4ba4ffd165e05cb
# SEAL_THRESHOLD=2
# SEAL_VERIFY_KEY_SERVERS=1
# Seal client HTTP timeout (ms) for key-server fetches (default 8000).
# SEAL_CLIENT_TIMEOUT_MS=8000

# Advanced: custom key servers JSON, e.g. decentralized + aggregator:
# SEAL_SERVER_CONFIGS=[{"objectId":"0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98","weight":1,"aggregatorUrl":"https://seal-aggregator-testnet.mystenlabs.com"}]
