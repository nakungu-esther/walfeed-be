PORT=5000
# Neon: use the pooled URL from the dashboard; keep ?sslmode=require (omit channel_binding if you see flaky connections on Windows).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-host.neon.tech/neondb?sslmode=require"
JWT_SECRET=supersecret

# devnet | testnet | mainnet — Walrus SDK / uploads route here
WALRUS_NETWORK=devnet
WALRUS_ENDPOINT=https://devnet.walrus.xyz

# Defaults to WALRUS_NETWORK when unset
SEAL_NETWORK=devnet
SEAL_API_KEY=your_seal_key
